.PHONY : benchmarks/benchmark_engine.cpp.i

benchmarks/benchmark_engine.s: benchmarks/benchmark_engine.cpp.s
.PHONY : benchmarks/benchmark_engine.s

# target to generate assembly for a file
benchmarks/benchmark_engine.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/hft_benchmarks.dir/build.make CMakeFiles/hft_benchmarks.dir/benchmarks/benchmark_engine.cpp.s
.PHONY : benchmarks/benchmark_engine.cpp.s

src/auditor.o: src/auditor.cpp.o
